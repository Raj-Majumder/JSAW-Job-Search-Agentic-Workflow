# --- Config folder: never commit (secrets live alongside non-secret files here) ---
config/

# --- Personal / generated data: keep the folder structure, not the contents ---
Job Alerts/*
!Job Alerts/.gitkeep

context_hub/*
!context_hub/.gitkeep

Agent output_Updated Cover and resumes/*
!Agent output_Updated Cover and resumes/.gitkeep

state/*
!state/.gitkeep
!state/drafts
state/drafts/*

logs/*
!logs/.gitkeep

# --- Jupyter / OS / Python noise (also catches any .env accidentally
# saved into a checkpoint, e.g. config/.ipynb_checkpoints/*.env) ---
.ipynb_checkpoints/
__pycache__/
*.pyc
.DS_Store

# --- Stale/duplicate notebooks kept on disk, not tracked ---
JOB SEARCH AGENTIC ORCHESTRATION.ipynb
Raj_JSAW_Master v.1.ipynb
Untitled.ipynb
